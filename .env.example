# Copy to .env and adjust. docker compose reads .env automatically.

# Signing key for access and refresh tokens. At least 32 characters. Use your own random value.
JWT_SECRET=replace-with-your-own-random-string-of-32-plus-characters

# Optional: create an initial administrator at startup (both must be set).
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Set to false to run without the Redis cache.
APP_CACHE_ENABLED=true
